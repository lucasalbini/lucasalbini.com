# PostgreSQL
POSTGRES_USER=strapi
POSTGRES_PASSWORD=strapi_password
POSTGRES_DB=strapi

# Strapi (all secrets MUST be set — Strapi refuses to boot otherwise)
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=your_api_token_salt
STRAPI_ADMIN_JWT_SECRET=your_admin_jwt_secret
STRAPI_TRANSFER_TOKEN_SALT=your_transfer_token_salt
STRAPI_JWT_SECRET=your_jwt_secret

# Strapi → FastAPI outbound webhook (set the same value on both sides)
STRAPI_WEBHOOK_SECRET=change_me_shared_between_strapi_and_fastapi

# FastAPI
STRAPI_BASE_URL=http://strapi:1337
STRAPI_API_TOKEN=your_strapi_api_token
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CACHE_TTL=300
CONTACT_MAX_PER_HOUR=5
DEFAULT_LOCALE=pt-BR

# FastAPI → Next revalidation (both must be set for revalidateTag to fire)
NEXT_URL=http://frontend:3000
REVALIDATE_SECRET=change_me_shared_between_fastapi_and_frontend

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SITE_URL=http://localhost

# Strapi CORS (comma-separated, only needed in production)
# STRAPI_CORS_ORIGINS=https://lucasalbini.com,http://fastapi:8000
